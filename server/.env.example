# ─── Kalamio API — Environment Variables ───
# Copy this file to .env. The values below work out of the box with the local
# services from `docker compose up -d` (see CONTRIBUTING.md) — no cloud accounts needed.
# For production, every value is replaced (Cloud Run env vars / Secret Manager).

# ── Required ──────────────────────────────────
# Local MongoDB from docker-compose. Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
DB_LOCATION=mongodb://localhost:27017/kalamio

# Local-dev-only values — NEVER use these anywhere real. Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me

# Email (signup / password-reset codes). Locally every email lands in Mailpit:
# open http://localhost:8025 to read them. Production (Resend): SMTP_HOST=smtp.resend.com,
# SMTP_PORT=465, EMAIL_USER=resend, EMAIL_PASS=<Resend API key>, EMAIL_FROM=no-reply@kalamio.com.
# EMAIL_FROM is the visible sender; unset, it falls back to EMAIL_USER.
EMAIL_USER=dev@kalamio.local
EMAIL_PASS=local-dev
SMTP_HOST=localhost
SMTP_PORT=1025
# EMAIL_FROM=

# Image storage. Locally: MinIO (S3-compatible) from docker-compose — browse files at
# http://localhost:9001 (login with the two keys below). Production: unset S3_ENDPOINT
# and use real AWS credentials + bucket.
S3_ENDPOINT=http://localhost:9000
AWS_BUCKET=kalamio-dev
AWS_ACCESS_KEY=kalamio
AWS_SECRET_ACCESS_KEY=kalamio-dev-secret
AWS_REGION=us-east-1

# Where the frontend runs — used for redirects and links in emails
FRONTEND_URL=http://localhost:5173

# ── Optional (have defaults) ─────────────────
# PORT=8080
# NODE_ENV=development

# ── Google OAuth (optional — enables Google sign-in) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=/api/auth/google/callback

# ─── Response caching (optional) ───
# Upstash Redis REST credentials. If unset, response caching is disabled and the
# API behaves normally. Get these from the Upstash console (REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Socket.IO cross-instance broadcast (REQUIRED in production, optional in single-instance dev) ───
# Locally: the Redis from docker-compose. Production: the Upstash Redis PROTOCOL connection string
# (rediss://…, distinct from the REST creds above — the REST API can't do pub/sub). Get it from the
# Upstash console → your database → "Redis" tab. Without it, real-time silently breaks across multiple
# Cloud Run instances (single-instance fallback).
REDIS_URL=redis://localhost:6379

# ─── Cloudflare origin lock (optional) ───
# Set to a long random string that matches a Cloudflare Transform Rule adding
# `X-Origin-Secret: <value>`. Blocks requests that bypass Cloudflare. Unset = off.
CLOUDFLARE_ORIGIN_SECRET=

# ─── Kalamio AI assistant ───
# Encrypts users' AI provider API keys at rest (AES-256-GCM): 32 random bytes, base64. Without it the
# /api/v1/ai endpoints answer 503. Local-dev-only value below — NEVER reuse it anywhere real; production
# mounts its own from Secret Manager. Changing it makes every saved key unreadable (users re-add them).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEY_ENCRYPTION_KEY=GYQNZI3F141Se5MUNkH14FRTk6ngrYaL3joKLgDir0E=

# Optional — enables the Moderation guardrail on AI input/output (OpenAI moderation API; any OpenAI key
# works and moderation calls are free). Unset = only the local PII guardrail runs.
OPENAI_MODERATION_API_KEY=
